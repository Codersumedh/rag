# Copy to UAIS_vars.env (same keys as Databricks ./Data/UAIS_vars.env)

MODEL_ENDPOINT=https://api.uhg.com/api/cloud/api-management/ai-gateway/1.0
API_VERSION=2025-01-01-preview
PROJECT_ID=your-project-id-here

# Chat (for get_response later)
CHAT_MODEL_NAME=gpt-4.1-mini_2025-04-14

# Embeddings deployment on the gateway
EMBEDDINGS_MODEL_NAME=your-embeddings-deployment-name

# Optional OAuth overrides
OAUTH_TOKEN_URL=https://api.uhg.com/oauth2/token
OAUTH_SCOPE=https://api.uhg.com/.default
